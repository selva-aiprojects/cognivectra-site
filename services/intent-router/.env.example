# Intent Router — Environment Variables
# ======================================================
# SECURITY: This file contains PLACEHOLDER values only.
# Never store real API keys here or commit them to git.
#
# HOW TO SET UP:
#   1. Generate a MASTER_KEY:
#        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   2. Encrypt each secret:
#        MASTER_KEY=your-master-key python ../scripts/encrypt_secret.py sk-openai-your-key-here
#   3. Copy the ENCRYPTED:... output as the value below
#   4. Store these ENCRYPTED values in your deploy platform (Railway/Render/Fly.io)
#      as environment secrets — not in this file
#
# MASTER_KEY: Store ONLY in platform secrets. Never here.
# ======================================================

# Fernet master decryption key (set in platform secrets — NOT here)
MASTER_KEY=your-fernet-master-key-from-platform-secrets

# OpenAI API key (encrypted — use encrypt_secret.py to generate)
OPENAI_API_KEY=ENCRYPTED:replace-with-fernet-encrypted-value

# === Phase 2 (Optional — LoRA model) ===
# Warm Adapter Registry: Comma-separated name:path pairs
# Example: LORA_ADAPTERS="general:/models/adapters/gen,healthcare:/models/adapters/hc"
LORA_ADAPTERS=

# Legacy single path (fallback)
LORA_ADAPTER_PATH=

# HuggingFace base model name
BASE_MODEL_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct

# HuggingFace token (if using gated model — encrypt same way as OPENAI_API_KEY)
HUGGINGFACE_TOKEN=ENCRYPTED:replace-with-fernet-encrypted-value
