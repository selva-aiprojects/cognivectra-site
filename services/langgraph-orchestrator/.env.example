# LangGraph Orchestrator — Environment Variables
# ======================================================
# SECURITY: Placeholder values only. See services/scripts/encrypt_secret.py
# to encrypt values before storing in your deploy platform.
# ======================================================

# Fernet master decryption key (platform secrets ONLY — never in git)
MASTER_KEY=your-fernet-master-key-from-platform-secrets

# Supabase connection (encrypted)
SUPABASE_URL=ENCRYPTED:replace-with-fernet-encrypted-value
SUPABASE_SERVICE_ROLE_KEY=ENCRYPTED:replace-with-fernet-encrypted-value

# OpenAI API key (encrypted, for LLM-backed agents in Phase 2+)
OPENAI_API_KEY=ENCRYPTED:replace-with-fernet-encrypted-value

# LangSmith tracing (optional — enable when ENABLE_LANGSMITH_TRACING flag is true)
LANGSMITH_API_KEY=ENCRYPTED:replace-with-fernet-encrypted-value
LANGSMITH_PROJECT=cognivectra-prod
