# LinkedIn API Credentials
# Get these from: https://www.linkedin.com/developers/apps/YOUR_NEW_APP_ID/auth

# Step 1: Create a NEW LinkedIn Developer App (dedicated for Community Management API)
# Step 2: Add Community Management API product to that app
# Step 3: Copy Client ID and Secret from the Auth tab
# Step 4: Generate access token using: node scripts/generate_linkedin_token.js

LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Your company URN (already confirmed)
LINKEDIN_COMPANY_URN=urn:li:organization:111480172

# Optional: Your personal URN (will be auto-detected when you generate the token)
LINKEDIN_PERSON_URN=

# Supabase Configuration (if not already set)
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
